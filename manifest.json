{
  "manifest_version": 3,
  "name": "Markdown Lens",
  "version": "0.2.4",
  "description": "Render local and plain-text Markdown files as HTML, fully offline.",
  "browser_specific_settings": {
    "gecko": {
      "id": "markdown-lens@ebal",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd",
        "file:///*.mkdn",
        "*://*/*.md",
        "*://*/*.markdown"
      ],
      "js": [
        "vendor/marked.min.js",
        "vendor/marked-footnote.min.js",
        "vendor/purify.min.js",
        "vendor/highlight.min.js",
        "vendor/katex/katex.min.js",
        "vendor/raphael.min.js",
        "vendor/underscore.min.js",
        "vendor/flowchart.min.js",
        "vendor/sequence-diagram.min.js",
        "content.js"
      ],
      "css": [
        "vendor/hljs-theme.css",
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*",
        "mermaid.html"
      ],
      "matches": [
        "file:///*",
        "*://*/*"
      ]
    }
  ]
}
