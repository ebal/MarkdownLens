{
  "manifest_version": 3,
  "name": "Markdown Viewer (offline)",
  "version": "0.1.0",
  "description": "Render local and plain-text Markdown files as HTML, fully offline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd",
        "file:///*.mkdn",
        "*://*/*.md",
        "*://*/*.markdown"
      ],
      "js": [
        "vendor/marked.min.js",
        "vendor/purify.min.js",
        "vendor/highlight.min.js",
        "content.js"
      ],
      "css": ["vendor/hljs-theme.css", "content.css"],
      "run_at": "document_end"
    }
  ]
}
